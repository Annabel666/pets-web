<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pets.hall.mapper.StageMapper">
  <select id="findAll" resultType="com.pets.hall.model.Stage">
    SELECT id, stage_date AS date, place, venue, title, note, kind, voice_id
    FROM stage
    ORDER BY sort_no
  </select>
</mapper>
